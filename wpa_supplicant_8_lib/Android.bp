cc_library_static {
    name: "lib_driver_cmd_mt66xx",
    srcs: ["driver_cmd_nl80211.c"],
    header_libs: [
        "wpa_supplicant_headers",
    ],
    cflags: [
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-macro-redefined",
    ],
    soc_specific: true,
}
