# mtk_hal_camera (device/mediatek/sepolicy_vndr) already grants find access to the old
# HIDL-era fwk_sensor_hwservice, but was never updated for the AIDL-era
# android.frameworks.sensorservice.ISensorManager/default service (fwk_sensor_service,
# looked up via service_manager rather than hwservice_manager) that current AOSP camera
# HALs also probe - confirmed live via a real AVC denial (190 occurrences during one
# camera session): "avc: denied { find } ... scontext=u:r:mtk_hal_camera:s0
# tcontext=u:object_r:fwk_sensor_service:s0 tclass=service_manager". AOSP's own generic
# hal_camera_default already carries this exact grant (system/sepolicy/vendor/
# hal_camera_default.te), as do hal_fingerprint_default/hal_face_default/
# hal_audio_default - this is a standard, expected permission for HAL domains that need
# sensor manager access, not something unusual to grant.
allow mtk_hal_camera fwk_sensor_service:service_manager find;
